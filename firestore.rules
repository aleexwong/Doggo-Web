rules_version = '2';

// Rules for the Doggo Web leaderboard. Documents are created client-side
// (unauthenticated) via the Firestore REST API, so all abuse protection
// lives here: create-only, strict schema, bounded values.
service cloud.firestore {
  match /databases/{database}/documents {

    function validEntry() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'score', 'createdAt'])
        && d.keys().hasAll(['name', 'score', 'createdAt'])
        && d.name is string
        && d.name.size() >= 2
        && d.name.size() <= 16
        && d.score is int
        && d.score >= 1
        && d.score <= 10000
        // The client stamps createdAt with new Date().toISOString(); allow
        // a small clock skew around the server's request.time rather than
        // requiring exact equality (which would always fail).
        && d.createdAt is timestamp
        && d.createdAt > request.time - duration.value(5, 'm')
        && d.createdAt < request.time + duration.value(5, 'm');
    }

    match /web_leaderboard_streak/{doc} {
      allow read: if true;
      allow create: if validEntry();
      allow update, delete: if false;
    }

    match /web_leaderboard_blitz/{doc} {
      allow read: if true;
      allow create: if validEntry();
      allow update, delete: if false;
    }

    // Everything else: denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
