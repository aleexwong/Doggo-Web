# Firebase web client config for the Top Dogs leaderboard.
# Copy to .env.local (gitignored) or set these in your deploy environment.
# Values come from the Firebase console (or the Android app's
# google-services.json: project_id and api_key.current_key).
# Leave unset to ship the game without the leaderboard.
VITE_FB_PROJECT_ID=
VITE_FB_API_KEY=

# Optional: URL of the deployed submitScore Cloud Function (see functions/).
# When set, score posts go through the server-side validator instead of
# writing to Firestore directly. Leave unset for direct client writes.
VITE_LEADERBOARD_WRITE_URL=

# Optional: restrict who receives the anonymous play events the game posts to
# its embedding page (see "Tracking play from your site" in the README).
# Unset broadcasts to whatever page embeds the game, which is fine for
# anonymous counters; set it to your site's origin to narrow that.
VITE_TRACK_ORIGIN=
